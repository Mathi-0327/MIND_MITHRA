# ═══════════════════════════════════════════════════════════════════
# MIND MITHRA — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ─── GEMINI AI ─────────────────────────────────────────────────────
# Required for AI companion, voice, mood detection, and memory RAG.
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ─── APPLICATION URL ────────────────────────────────────────────────
# The public URL of your application (used for OAuth callbacks & email links)
# In development: http://localhost:3000
# In production: https://your-app.vercel.app
APP_URL="http://localhost:3000"

# ─── SESSION SECRET ─────────────────────────────────────────────────
# Strong random string for signing session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET="replace-this-with-a-64-char-random-string-in-production"

# ─── SQLITE DATABASE ─────────────────────────────────────────────────
# Path to the SQLite database file. Defaults to mind_mithra.db in project root.
# In production on Vercel, use a persistent volume path.
# DATABASE_PATH="/data/mind_mithra.db"

# ─── GOOGLE OAUTH (optional — leave as-is until you have credentials) ─
# Get credentials from: https://console.cloud.google.com
# Authorized Redirect URI to add: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ─── EMAIL / GMAIL SMTP ─────────────────────────────────────────────
# For password reset emails via Gmail.
# 1. Enable 2-Step Verification on your Gmail account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use your Gmail address and the App Password below
GMAIL_USER="YOUR_GMAIL@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

# ─── NODE ENVIRONMENT ────────────────────────────────────────────────
NODE_ENV="development"
